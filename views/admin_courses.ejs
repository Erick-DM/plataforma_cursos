<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Plataforma de cursos</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" type="image/png" href="images/logo_cursdev.png">
</head>
<body>
  <header>
    <div class="container">
      <nav style="display: flex; align-items: center; justify-content: space-between;">
        
        <!-- Logo y Nombre que redirigen al Dashboard al hacer clic -->
        <a class="brand" href="/dashboard" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: #fff;">
          <img src="/images/logo_cursdev.png" alt="Logo CRUSDEV" style="height: 32px; width: auto;" />
          <span style="font-weight: bold; font-size: 1.2rem; letter-spacing: 1px;">CURSDEV</span>
        </a>
  
          <!-- Si tienes botón de salir -->
          <a class="btn btn-danger" href="/logout">Salir</a>
        </div>
      </nav>
    </div>
  </header>

  <main class="container">
    <section class="hero" style="margin-bottom: 2rem;">
      <div class="hero-card" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span class="badge">Administración</span>
          <h1>Gestión de Cursos</h1>
          <p class="muted">Administra el catálogo de cursos, modifica su contenido o crea nuevos trayectos formativos.</p>
        </div>
        <div>
          <a href="/admin/courses/new" class="btn btn-primary" style="padding: 0.75rem 1.5rem; text-decoration: none;">+ Crear Nuevo Curso</a>
        </div>
      </div>
    </section>

    <% if (locals.message) { %>
      <div class="alert" style="margin-bottom: 1.5rem; padding: 1rem; background: rgba(59, 130, 246, 0.1); border: 1px solid #3b82f6; border-radius: 8px; color: #60a5fa;">
        <%= message %>
      </div>
    <% } %>

    <div class="courses-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
      <% courses.forEach(course => { %>
        <div class="card" style="background: #121824; border: 1px solid #1f293d; border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <span class="badge" style="font-size: 0.75rem;"><%= course.level %></span>
              <small class="muted">ID: <%= course.id %></small>
            </div>
            <h3 style="margin-bottom: 0.5rem; color: #fff;"><%= course.title %></h3>
            <p class="muted" style="font-size: 0.9rem; line-height: 1.4; margin-bottom: 1rem;"><%= course.description %></p>
          </div>

          <div style="border-top: 1px solid #1f293d; padding-top: 1rem; margin-top: 1rem; display: flex; flex-direction: column; gap: 0.5rem;">
            <div style="display: flex; gap: 0.5rem;">
              <a href="/admin/courses/edit/<%= course.id %>" class="btn btn-secondary" style="flex: 1; text-align: center; font-size: 0.85rem; text-decoration: none;">✏️ Editar</a>
              <a href="/admin/courses/<%= course.id %>/modules" class="btn btn-secondary" style="flex: 1; text-align: center; font-size: 0.85rem; text-decoration: none;">📚 Módulos</a>
            </div>

            <form action="/admin/courses/delete/<%= course.id %>" method="POST" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este curso y todos sus módulos asociados? Esta acción no se puede deshacer.');">
              <button type="submit" class="btn" style="width: 100%; background: #dc2626; color: white; border: none; padding: 0.5rem; font-size: 0.85rem; border-radius: 6px; cursor: pointer;">🗑️ Eliminar curso</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </main>
</body>
</html>