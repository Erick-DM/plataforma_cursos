<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | Plataforma de cursos</title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="icon" type="image/png" href="images/logo_cursdev.png">
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <a class="brand" href="/dashboard" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: #fff;">
            <img src="/images/logo_cursdev.png" alt="Logo CRUSDEV" style="height: 32px; width: auto;" />
            <span style="font-weight: bold; font-size: 1.2rem; letter-spacing: 1px;">CURSDEV</span>
          </a>
          <div class="nav-links">
            <a class="btn btn-secondary" href="/login">Iniciar sesión</a>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <div class="form-card">
        <h2>Crear cuenta</h2>
        <% if (message) { %><p class="muted"><%= message %></p><% } %>
        <form class="form-grid" method="POST" action="/register">
          <input class="input" type="text" name="name" placeholder="Tu nombre" required />
          <input class="input" type="email" name="email" placeholder="Correo electrónico" required />
          <input class="input" type="password" name="password" placeholder="Contraseña" required />
          <button class="btn btn-primary" type="submit">Registrarme</button>
        </form>
      </div>
    </main>
  </body>
</html>
