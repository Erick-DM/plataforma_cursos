<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Plataforma de cursos</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="icon" type="image/png" href="images/logo_cursdev.png">
</head>
<body>
  <header>
    <div class="container">
      <nav>
        <a class="brand" href="/admin/courses">Volver a gestión de cursos</a>
        <div class="nav-links">
          <a class="btn btn-secondary" href="/logout">Cerrar sesión</a>
        </div>
      </nav>
    </div>
  </header>

  <main class="container">
    <section class="hero" style="margin-bottom: 2rem;">
      <div class="hero-card">
        <span class="badge">Administración</span>
        <h1>Módulos de: <%= course.title %></h1>
        <p class="muted">Lista ordenada de lecciones para este curso.</p>
      </div>
    </section>

    <% if (locals.message) { %>
      <div class="alert" style="margin-bottom: 1.5rem; padding: 1rem; background: rgba(59, 130, 246, 0.1); border: 1px solid #3b82f6; border-radius: 8px; color: #60a5fa;">
        <%= message %>
      </div>
    <% } %>

    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <% modules.forEach((mod) => { %>
        <div style="background: #121824; border: 1px solid #1f293d; border-radius: 8px; padding: 1.25rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.3rem;">
              <span class="badge" style="font-size: 0.75rem;">Módulo <%= mod.theme_order %></span>
              <h3 style="margin: 0; color: #fff; font-size: 1.1rem;"><%= mod.title %></h3>
            </div>
            <p class="muted" style="margin: 0; font-size: 0.85rem;"><%= mod.summary %></p>
          </div>
          <a href="/admin/modules/edit/<%= mod.id %>" class="btn btn-secondary" style="font-size: 0.85rem; text-decoration: none; white-space: nowrap;">✏️ Editar Módulo</a>
        </div>
      <% }) %>
    </div>
  </main>
</body>
</html>