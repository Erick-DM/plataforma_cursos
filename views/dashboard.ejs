<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | Plataforma de cursos</title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="icon" type="image/png" href="images/logo_cursdev.png">
  </head>
  <body>
    
    <header>
      <div class="container">
        <nav style="display: flex; align-items: center; justify-content: space-between;">
          
          <!-- Logo y Nombre que redirigen al Dashboard al hacer clic -->
          <a class="brand" href="/dashboard" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: #fff;">
            <img src="/images/logo_cursdev.png" alt="Logo CRUSDEV" style="height: 32px; width: auto;" />
            <span style="font-weight: bold; font-size: 1.2rem; letter-spacing: 1px;">CURSDEV</span>
          </a>
    
            <!-- Si tienes botón de salir -->
            <a class="btn btn-danger" href="/logout">Salir</a>
          </div>
        </nav>
      </div>
    </header>
    <main class="container">
      <section class="hero">
        <div class="hero-card">
          <span class="badge">Bienvenido</span>
          <h1>Hola <%= user.name %>, tu ruta de aprendizaje está lista</h1>
          <p>Cada curso cuenta con 10 módulos, videos integrados y un examen que solo se desbloquea después de ver todo el temario.</p>

          <% if (typeof message !== 'undefined' && message) { %>
            <p class="muted"><%= message %></p>
          <% } %>

          <% if (user && (user.role === 'admin' || user.role === 'Admin')) { %>
            <div class="inline-list" style="margin-top: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <a class="btn btn-primary" href="/admin/courses">⚙️ Gestionar Cursos</a>
              <a class="btn btn-primary" href="/admin/courses/new">+ Añadir Curso</a>
              <a class="btn" href="/admin/users" style="background: #3498db; color: white; padding: 8px 12px; border-radius: 4px; text-decoration: none;">👥 Control Usuarios</a>
            </div>
          <% } %>
        </div>
        <img src="/images/cloud.svg" alt="Progreso del curso" />
      </section>

      <section class="course-grid">
        <% courses.forEach((course) => { %>
          <div class="card course-card">
            <img class="course-image" src="<%= course.image %>" alt="<%= course.title %>" />
            <span class="badge"><%= course.level %></span>
            <h3><%= course.title %></h3>
            <p class="muted"><%= course.description %></p>

            <div class="status-pill <%= course.locked ? 'locked' : (course.progress && course.progress.completed ? 'pass' : '') %>">
              <%= course.locked ? 'Bloqueado' : (course.progress && course.progress.completed ? 'Aprobado' : 'En progreso') %>
            </div>

            <div class="progress-track">
              <div class="progress-bar" style="--progress: <%= course.progressPercent %>%; width: var(--progress);"></div>
            </div>

            <p class="muted">Temas vistos: <%= course.viewedThemes %> / <%= course.totalThemes %> · Progreso: <%= course.progressPercent %>%</p>

            <% if (course.locked) { %>
              <a class="btn btn-secondary" href="#">Esperando aprobación</a>
            <% } else { %>
              <a class="btn btn-primary" href="/courses/<%= course.id %>">Ingresar al curso</a>
            <% } %>
          </div>
        <% }) %>
      </section>
    </main>
  </body>
</html>image.png