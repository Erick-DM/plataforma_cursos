<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | Plataforma de cursos</title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="icon" type="image/png" href="images/logo_cursdev.png">
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <a class="brand" href="/">Unidad IV · Desarrollo Web</a>
          <div class="nav-links">
            <a class="btn btn-secondary" href="/register">Crear cuenta</a>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <div class="form-card">
        <h2>Iniciar sesión</h2>
        <% if (message) { %><p class="muted"><%= message %></p><% } %>
        <form class="form-grid" method="POST" action="/login">
          <input class="input" type="email" name="email" placeholder="Correo electrónico" required />
          <input class="input" type="password" name="password" placeholder="Contraseña" required />
          <button class="btn btn-primary" type="submit">Entrar</button>
        </form>
      </div>
    </main>
  </body>
</html>
