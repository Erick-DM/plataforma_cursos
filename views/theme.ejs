<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | Plataforma de cursos</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <a class="brand" href="/courses/<%= course.id %>">Volver al curso</a>
          <div class="nav-links">
            <a class="btn btn-secondary" href="/dashboard">Panel</a>
          </div>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="hero">
        <div class="hero-card">
          <span class="badge"><%= course.title %></span>
          <h1><%= theme.title %></h1>
          <p class="muted"><%= theme.summary || theme.content %></p>
        </div>
        <% if (theme.image1) { %>
          <img class="course-image" src="<%= theme.image1 %>" alt="<%= theme.title %>" />
        <% } else { %>
          <img src="/images/testing.svg" alt="Detalle del módulo" />
        <% } %>
      </section>

      <!-- Contenido principal del módulo -->
      <section class="card module-content-card">
        <%- theme.info_html || theme.content %>
      </section>

      <!-- SECCIÓN DE VIDEO: Posicionada antes de la navegación -->
      <% 
        // Determinar URL del video desde la vista o desde el objeto theme
        let currentVideoUrl = typeof videoEmbedUrl !== 'undefined' && videoEmbedUrl ? videoEmbedUrl : '';
        if (!currentVideoUrl && theme && theme.video_url) {
          const match = theme.video_url.match(/(?:v=|\/embed\/|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
          if (match && match[1]) {
            currentVideoUrl = 'https://www.youtube.com/embed/' + match[1];
          }
        }
      %>

      <% if (currentVideoUrl || (typeof showCourseVideo !== 'undefined' && showCourseVideo)) { %>
        <section class="card video-card" style="margin-top: 2rem; margin-bottom: 2rem;">
          <div class="video-header" style="margin-bottom: 1rem;">
            <div>
              <span class="badge">Video del curso</span>
              <h3 style="margin-top: 0.5rem; color: #fff;">Explicación visual de la lección</h3>
            </div>
            <% if (typeof videoInfo !== 'undefined' && videoInfo && videoInfo.title) { %>
              <p class="muted"><%= videoInfo.title %></p>
            <% } %>
          </div>
          <div class="video-container" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px; background: #000;">
            <iframe 
              class="video-frame" 
              src="<%= currentVideoUrl %>" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
              style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;">
            </iframe>
          </div>
        </section>
      <% } %>

      <!-- Navegación entre módulos -->
      <section class="module-navigation">
        <% if (previousTheme) { %>
          <a class="btn btn-secondary" href="/themes/<%= previousTheme.id %>">Módulo anterior</a>
        <% } %>
        <% if (nextTheme) { %>
          <a class="btn btn-primary btn-next-module" href="/themes/<%= nextTheme.id %>" data-next-url="/themes/<%= nextTheme.id %>" data-progress="<%= Math.round(((currentThemeIndex + 1) / totalThemes) * 100) %>">Siguiente módulo</a>
        <% } else { %>
          <a class="btn btn-primary" href="/courses/<%= course.id %>">Volver al curso</a>
        <% } %>
      </section>

      <div class="next-module-overlay" id="nextModuleOverlay" aria-hidden="true">
        <div class="next-module-ring" role="status" aria-live="polite">
          <svg class="progress-ring" width="180" height="180" viewBox="0 0 120 120" aria-hidden="true">
            <circle class="bg" cx="60" cy="60" r="52"></circle>
            <circle class="progress" id="progressCircle" cx="60" cy="60" r="52" stroke-dasharray="326.7256" stroke-dashoffset="326.7256"></circle>
          </svg>
          <div class="ring-text"><span id="nextModuleText">Avance 0%</span></div>
        </div>
      </div>

      <script>
        document.querySelectorAll('.btn-next-module').forEach((button) => {
          button.addEventListener('click', (event) => {
            event.preventDefault();
            const overlay = document.getElementById('nextModuleOverlay');
            const text = document.getElementById('nextModuleText');
            const progressCircle = document.getElementById('progressCircle');
            const progress = parseInt(button.dataset.progress || '0', 10);
            if (overlay && text && progressCircle) {
              text.textContent = `Avance ${progress}%`;
              overlay.classList.remove('show');
              requestAnimationFrame(() => {
                overlay.classList.add('show');
                const r = parseFloat(progressCircle.getAttribute('r'));
                const c = 2 * Math.PI * r;
                const offset = Math.max(0, c * (1 - (progress / 100)));
                progressCircle.style.transition = 'stroke-dashoffset 1s ease';
                progressCircle.style.strokeDasharray = c;
                progressCircle.style.strokeDashoffset = offset;
                window.setTimeout(() => {
                  window.location.href = button.dataset.nextUrl;
                }, 1000);
              });
            } else {
              window.location.href = button.dataset.nextUrl;
            }
          });
        });
      </script>
    </main>
  </body>
</html>